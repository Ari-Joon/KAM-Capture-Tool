<Window x:Class="KamCapture.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install KAM Capture Tool" Height="520" Width="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Navy}" UseLayoutRounding="True">

    <Grid Margin="26,22,26,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Grid Width="52" Height="52" VerticalAlignment="Center">
                <Ellipse Fill="#FF0A0D14"/>
                <Path Stroke="#FF4A7CFF" StrokeThickness="3.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Stretch="None" Width="52" Height="52"
                      Data="M12,19.5 L12,12 L19.5,12 M32.5,12 L40,12 L40,19.5 M12,32.5 L12,40 L19.5,40 M40,32.5 L40,40 L32.5,40"/>
                <Path Fill="#FF3A63D8" Stretch="None" Width="52" Height="52"
                      Data="M19.2,32.8 L32.8,19.2 L36.1,22.5 L22.5,36.1 Z"/>
                <Path Fill="#FF9CBEFF" Stretch="None" Width="52" Height="52"
                      Data="M19.2,32.8 L22.5,36.1 L15.9,38.4 Z"/>
            </Grid>
            <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="KAM Capture Tool" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="LblVersion" Style="{StaticResource Label}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="Where should it go?"/>
                <TextBlock Style="{StaticResource Label}" Margin="0,4,0,12" TextWrapping="Wrap"
                           Text="The default needs no administrator rights. Anywhere you can write to will do."/>

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TxtFolder" Width="446" VerticalAlignment="Center"/>
                    <Button Content="Browse…" Margin="8,0,0,0" Click="OnBrowse"/>
                </StackPanel>

                <TextBlock x:Name="LblSpace" Style="{StaticResource Label}" Margin="0,8,0,0"/>

                <WrapPanel Margin="0,16,0,0">
                    <CheckBox x:Name="ChkDesktop" Content="Desktop shortcut" IsChecked="True" Margin="0,0,24,10"/>
                    <CheckBox x:Name="ChkStartMenu" Content="Start menu" IsChecked="True" Margin="0,0,24,10"/>
                    <CheckBox x:Name="ChkStartup" Content="Start with Windows" Margin="0,0,24,10"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,18,0,0">
            <TextBlock x:Name="LblStatus" Style="{StaticResource Label}" TextWrapping="Wrap" MinHeight="34"/>
            <ProgressBar x:Name="Bar" Height="4" Visibility="Collapsed" IsIndeterminate="True"
                         Background="#FF10151E" Foreground="{StaticResource Accent}" BorderThickness="0"/>
        </StackPanel>

        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,18,0,18">
            <Button x:Name="BtnPortable" Content="Just run it, don't install" Click="OnRunPortable"
                    ToolTip="Keep using this copy where it is. Nothing is written outside your settings folder."/>
            <Button DockPanel.Dock="Right" x:Name="BtnInstall" Style="{StaticResource PrimaryButton}"
                    Content="Install" MinWidth="120" Padding="18,9" Click="OnInstall"/>
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="Cancel" Margin="0,0,8,0"
                    MinWidth="88" Click="OnCancel"/>
        </DockPanel>
    </Grid>
</Window>
