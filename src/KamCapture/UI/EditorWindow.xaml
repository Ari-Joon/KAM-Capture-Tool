<Window x:Class="KamCapture.UI.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KAM Capture Tool" Height="820" Width="1220"
        MinHeight="700" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Navy}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="Ico" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="None"/>
        </Style>

        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Edge}"/>
            <Setter Property="Margin" Value="4,6,10,6"/>
        </Style>

        <!-- Every property group aligns the same way, so the bar never looks ragged. -->
        <Style x:Key="PropGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
        <Style x:Key="PropLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ actions ============ -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnNewCapture" Style="{StaticResource BarButton}"
                            Content="New capture" ToolTip="Take another capture — this one stays open  (Ctrl+N)"
                            Click="OnNewCapture"/>

                    <Border Style="{StaticResource Divider}"/>

                    <Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                            Padding="16,7" VerticalAlignment="Center"
                            Content="Save" ToolTip="Save a PNG to your captures folder  (Ctrl+S)" Click="OnSave"/>
                    <Button x:Name="BtnCopy" Style="{StaticResource BarButton}"
                            Content="Copy" ToolTip="Copy the whole board to the clipboard  (Ctrl+Shift+C)" Click="OnCopy"/>

                    <Border Style="{StaticResource Divider}"/>

                    <Button x:Name="BtnUndo" Style="{StaticResource BarButton}" Content="Undo" ToolTip="Ctrl+Z" Click="OnUndo"/>
                    <Button x:Name="BtnRedo" Style="{StaticResource BarButton}" Content="Redo" ToolTip="Ctrl+Y" Click="OnRedo"/>

                    <Border Style="{StaticResource Divider}"/>

                    <Button x:Name="BtnGroup" Style="{StaticResource BarButton}" Content="Group"
                            ToolTip="Bind the selected objects together so they move and scale as one  (Ctrl+G)" Click="OnGroup"/>
                    <Button x:Name="BtnUngroup" Style="{StaticResource BarButton}" Content="Ungroup"
                            ToolTip="Ctrl+Shift+G" Click="OnUngroup"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnSettings" Style="{StaticResource BarButton}"
                        Margin="6,0,0,0" Content="Settings" Click="OnSettings"/>
            </Grid>
        </Border>

        <!-- ============ tool properties ============ -->
        <Border Grid.Row="1" Background="{StaticResource Navy}" BorderBrush="{StaticResource Edge}"
                BorderThickness="0,0,0,1" Height="46">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">

                    <StackPanel x:Name="GrpColour" Style="{StaticResource PropGroup}">
                        <TextBlock Style="{StaticResource PropLabel}" Text="Colour"/>
                        <ContentControl x:Name="HostInkColor" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="GrpThickness" Style="{StaticResource PropGroup}">
                        <TextBlock Style="{StaticResource PropLabel}" Text="Thickness"/>
                        <Slider x:Name="SldThickness" Width="108" Minimum="1" Maximum="40" Value="3"
                                VerticalAlignment="Center" ValueChanged="OnThicknessChanged"/>
                        <TextBlock x:Name="LblThickness" Width="24" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextAlignment="Right" Text="3"/>
                    </StackPanel>

                    <StackPanel x:Name="GrpFont" Style="{StaticResource PropGroup}">
                        <TextBlock Style="{StaticResource PropLabel}" Text="Size"/>
                        <Slider x:Name="SldFont" Width="124" Minimum="6" Maximum="160" Value="18"
                                VerticalAlignment="Center" ValueChanged="OnFontSizeChanged"/>
                        <TextBox x:Name="TxtFont" Width="46" Margin="8,0,0,0" Text="18"
                                 VerticalAlignment="Center" TextAlignment="Center"
                                 KeyDown="OnFontSizeTyped" LostFocus="OnFontSizeTypedCommit"/>
                        <ToggleButton x:Name="TglBold" Style="{StaticResource ToolToggle}" Width="32" Height="28"
                                      Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Bold" Click="OnBoldToggled">
                            <TextBlock Text="B" FontWeight="Bold" FontFamily="Arial" FontSize="14"/>
                        </ToggleButton>
                        <CheckBox x:Name="ChkTextBg" Margin="14,0,0,0" VerticalAlignment="Center"
                                  Content="Backdrop" Click="OnTextBgToggled"
                                  ToolTip="A solid plate behind the text so it stays readable over a busy screenshot"/>
                    </StackPanel>

                    <StackPanel x:Name="GrpShape" Style="{StaticResource PropGroup}">
                        <CheckBox x:Name="ChkFill" VerticalAlignment="Center" Content="Fill" Click="OnFillToggled"/>
                        <ContentControl x:Name="HostFillColor" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="GrpStep" Style="{StaticResource PropGroup}">
                        <TextBlock Style="{StaticResource PropLabel}" Text="Sequence"/>
                        <ComboBox x:Name="CmbStepStyle" Width="118" VerticalAlignment="Center"
                                  SelectionChanged="OnStepStyleChanged"/>
                        <TextBlock x:Name="LblNextStep" Style="{StaticResource PropLabel}" Margin="12,0,0,0"/>
                        <Button Style="{StaticResource BarButton}" Margin="6,0,0,0" Content="Restart"
                                Click="OnResetSteps" ToolTip="Start the sequence again from the beginning"/>
                    </StackPanel>

                    <StackPanel x:Name="GrpSymbol" Style="{StaticResource PropGroup}">
                        <TextBlock Style="{StaticResource PropLabel}" Text="Symbol"/>
                        <ContentControl x:Name="HostSymbol" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkSymbolFilled" Margin="14,0,0,0" VerticalAlignment="Center"
                                  Content="Solid" Click="OnSymbolFilledToggled" ToolTip="Solid glyph, or outline only"/>
                        <TextBlock Style="{StaticResource PropLabel}" Text="Rotate" Margin="14,0,8,0"/>
                        <Slider x:Name="SldRotate" Width="104" Minimum="0" Maximum="360" Value="0"
                                VerticalAlignment="Center" ValueChanged="OnRotationChanged"/>
                        <TextBlock x:Name="LblRotate" Width="36" Margin="8,0,0,0" VerticalAlignment="Center"
                                   TextAlignment="Right" Text="0"/>
                    </StackPanel>

                    <StackPanel x:Name="GrpRedact" Style="{StaticResource PropGroup}">
                        <TextBlock Style="{StaticResource PropLabel}" Text="Block size"/>
                        <Slider x:Name="SldRedact" Width="108" Minimum="3" Maximum="40" Value="12"
                                VerticalAlignment="Center" ValueChanged="OnRedactChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="GrpHint" Style="{StaticResource PropGroup}">
                        <TextBlock x:Name="LblToolHint" Style="{StaticResource PropLabel}" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ tools + board ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
                <StackPanel x:Name="ToolStrip" Margin="8,10" Width="44">

                    <ToggleButton Tag="Select" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Select, move, group and scale  (V)">
                        <Path Style="{StaticResource Ico}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="M5,3 L5,17 L8.6,13.4 L11,18.5 L13,17.6 L10.7,12.7 L15.5,12.4 Z"/>
                    </ToggleButton>

                    <ToggleButton Tag="MoveImage" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Move the screenshot around the board  (M).  Hold Space to pan the view.">
                        <Path Style="{StaticResource Ico}"
                              Data="M10,2.5 L12.2,5.2 L10.7,5.2 L10.7,9.3 L14.8,9.3 L14.8,7.8 L17.5,10 L14.8,12.2 L14.8,10.7 L10.7,10.7 L10.7,14.8 L12.2,14.8 L10,17.5 L7.8,14.8 L9.3,14.8 L9.3,10.7 L5.2,10.7 L5.2,12.2 L2.5,10 L5.2,7.8 L5.2,9.3 L9.3,9.3 L9.3,5.2 L7.8,5.2 Z"/>
                    </ToggleButton>

                    <Border Height="1" Background="{StaticResource Edge}" Margin="6,8"/>

                    <ToggleButton Tag="Pencil" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Pencil, freehand  (P)">
                        <Path Style="{StaticResource Ico}" Data="M3.5,16.5 L3.5,13.2 L13,3.7 L16.3,7 L6.8,16.5 Z M11.8,4.9 L15.1,8.2"/>
                    </ToggleButton>

                    <ToggleButton Tag="Highlighter" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Highlighter  (K)">
                        <Path Style="{StaticResource Ico}" StrokeThickness="1.5"
                              Data="M4.5,13.5 L11.5,4.5 L15.5,8 L8.5,16.5 L4.5,16.5 Z M3,18.6 L17,18.6"/>
                    </ToggleButton>

                    <ToggleButton Tag="Arrow" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Arrow  (A)">
                        <Path Style="{StaticResource Ico}" Data="M4,16 L16,4 M16,4 L10.3,4.7 M16,4 L15.3,9.7"/>
                    </ToggleButton>

                    <ToggleButton Tag="Line" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Line  (L)">
                        <Path Style="{StaticResource Ico}" Data="M4,16 L16,4"/>
                    </ToggleButton>

                    <ToggleButton Tag="Rectangle" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Rectangle  (R)">
                        <Path Style="{StaticResource Ico}" Data="M3.5,5 L16.5,5 L16.5,15 L3.5,15 Z"/>
                    </ToggleButton>

                    <ToggleButton Tag="Ellipse" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Ellipse  (O)">
                        <Path Style="{StaticResource Ico}" Data="M3.5,10 A6.5,5.3 0 1 0 16.5,10 A6.5,5.3 0 1 0 3.5,10 Z"/>
                    </ToggleButton>

                    <ToggleButton Tag="Text" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Text box, Arial at any size  (T)">
                        <TextBlock Text="A" FontFamily="Arial" FontWeight="Bold" FontSize="17"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <ToggleButton Tag="Step" Style="{StaticResource ToolToggle}" Click="OnToolClick"
                                  ToolTip="Numbered marker: 1 2 3, A B C, or i ii iii  (S)">
                        <Grid Width="20" Height="20">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                     StrokeThickness="1.6" Width="17" Height="17"/>
                            <TextBlock Text="1" FontFamily="Arial" FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton Tag="Symbol" Style="{StaticResource ToolToggle}" Click="OnToolClick"
                                  ToolTip="Symbols: arrows, circles, ticks, callouts and more  (D)">
                        <Path Style="{StaticResource Ico}" StrokeThickness="1.5"
                              Data="M2.5,10.5 L11,10.5 M11,10.5 L8,7.5 M11,10.5 L8,13.5 M14,4 L18,4 L18,8 L14,8 Z M14,12.5 A2.6,2.6 0 1 0 19.2,12.5 A2.6,2.6 0 1 0 14,12.5 Z"/>
                    </ToggleButton>

                    <ToggleButton Tag="Redact" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Redact, a mosaic over anything private  (X)">
                        <Path Style="{StaticResource Ico}" StrokeThickness="1.3"
                              Data="M3.5,5.5 L8,5.5 L8,10 L3.5,10 Z M12,5.5 L16.5,5.5 L16.5,10 L12,10 Z M8,10 L12.5,10 L12.5,14.5 L8,14.5 Z"/>
                    </ToggleButton>

                    <ToggleButton Tag="Crop" Style="{StaticResource ToolToggle}" Click="OnToolClick" ToolTip="Crop the screenshot  (C)">
                        <Path Style="{StaticResource Ico}" Data="M6,2 L6,14 L18,14 M2,6 L14,6 L14,18"/>
                    </ToggleButton>

                </StackPanel>
            </Border>

            <Border x:Name="BoardHost" Grid.Column="1" Background="#FF0C0C0E" ClipToBounds="True">
                <!-- Everything that used to crowd the toolbar lives here instead. -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Click="OnDuplicate"/>
                        <MenuItem Header="Delete" InputGestureText="Del" Click="OnDelete"/>
                        <Separator/>
                        <MenuItem Header="Bring to front" Click="OnBringFront"/>
                        <MenuItem Header="Send to back" Click="OnSendBack"/>
                        <Separator/>
                        <MenuItem Header="Group" InputGestureText="Ctrl+G" Click="OnGroup"/>
                        <MenuItem Header="Ungroup" InputGestureText="Ctrl+Shift+G" Click="OnUngroup"/>
                        <Separator/>
                        <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="OnSelectAll"/>
                        <Separator/>
                        <MenuItem Header="Save as..." Click="OnSaveAs"/>
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>
        </Grid>

        <!-- ============ status ============ -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
            <Grid Margin="14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="LblStatus" Style="{StaticResource Label}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PropLabel}" Text="Export"/>
                    <ComboBox x:Name="CmbExportScale" Width="70" VerticalAlignment="Center"
                              ToolTip="Drawings and text are vectors, so 2x or 3x genuinely sharpens them"
                              SelectionChanged="OnExportScaleChanged"/>

                    <Border Style="{StaticResource Divider}"/>

                    <Button Style="{StaticResource BarButton}" Content="-" Padding="12,5" Click="OnZoomOut"/>
                    <TextBlock x:Name="LblZoom" Style="{StaticResource Label}" VerticalAlignment="Center"
                               MinWidth="46" TextAlignment="Center"/>
                    <Button Style="{StaticResource BarButton}" Content="+" Padding="12,5" Margin="6,0,6,0" Click="OnZoomIn"/>
                    <Button Style="{StaticResource BarButton}" Content="Fit" Padding="12,5" Margin="0" Click="OnZoomFit"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
