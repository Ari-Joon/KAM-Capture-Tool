<Window x:Class="KamCapture.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KAM Capture Tool" Height="330" Width="568"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Navy}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="ModeTile" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Width" Value="168"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ModeIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
            <Grid Width="40" Height="40" VerticalAlignment="Center">
                <Ellipse Fill="#FF0C0C0E"/>
                <Path Stroke="#FFF7F7F5" StrokeThickness="2.2" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None"
                      Width="40" Height="40" Data="M7.8,13.7 L7.8,7.8 L13.7,7.8 M26.3,7.8 L32.2,7.8 L32.2,13.7 M7.8,26.3 L7.8,32.2 L13.7,32.2 M32.2,26.3 L32.2,32.2 L26.3,32.2"/>
                <TextBlock Text="KAM" Foreground="#FFD9A93A" FontFamily="Segoe UI" FontSize="8.5"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,9.6,0,0"/>
                <Path Fill="#FFD9A93A" Stretch="None" Width="40" Height="40" Data="M16.8,24.8 L27.8,24.8 L27.8,29.1 L16.8,29.1 Z"/>
                <Path Fill="#FF0C0C0E" Stretch="None" Width="40" Height="40" Data="M16.1,24.8 L16.8,24.8 L16.8,29.1 L16.1,29.1 Z"/>
                <Path Fill="#FFF7F7F5" Stretch="None" Width="40" Height="40" Data="M16.1,24.8 L16.1,29.1 L11.4,26.95 Z"/>
            </Grid>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="KAM Capture Tool" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="LblSubtitle" Style="{StaticResource Label}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <ToggleButton x:Name="ModeRegion" Style="{StaticResource ModeTile}" Tag="Region" Click="OnModeClick"
                          ToolTip="Drag any part of the screen. The selection stays adjustable before you commit.">
                <StackPanel>
                    <Path Style="{StaticResource ModeIcon}" Data="M3,7 L3,3 L7,3 M15,3 L19,3 L19,7 M3,15 L3,19 L7,19 M19,15 L19,19 L15,19"/>
                    <TextBlock Text="Capture" HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ModeWindow" Style="{StaticResource ModeTile}" Tag="Window" Click="OnModeClick"
                          ToolTip="Hover any window and click it.">
                <StackPanel>
                    <Path Style="{StaticResource ModeIcon}" Data="M3,5 L19,5 L19,17 L3,17 Z M3,8.5 L19,8.5"/>
                    <TextBlock Text="Window" HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ModeMonitor" Style="{StaticResource ModeTile}" Tag="Monitor" Click="OnModeClick"
                          Margin="0" ToolTip="The whole display the pointer is on.">
                <StackPanel>
                    <Path Style="{StaticResource ModeIcon}" Data="M2.5,4 L19.5,4 L19.5,14.5 L2.5,14.5 Z M8,18 L14,18 M11,14.5 L11,18"/>
                    <TextBlock Text="Monitor" HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnCapture" Style="{StaticResource PrimaryButton}"
                    Content="New capture" Padding="0,13" FontSize="15" Click="OnCapture"/>
            <ComboBox Grid.Column="1" x:Name="CmbDelay" Width="112" Height="46" Margin="8,0,0,0"
                      VerticalContentAlignment="Center" ToolTip="Wait before capturing"/>
            <Button Grid.Column="2" x:Name="BtnRecord" Content="Record" Padding="22,13" Margin="8,0,0,0"
                    FontSize="15" Click="OnRecord"/>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="LblStatus" Style="{StaticResource Label}" TextWrapping="Wrap"
                   Margin="0,18,0,0" VerticalAlignment="Top"/>

        <Grid Grid.Row="4" Margin="0,12,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Settings" Click="OnSettings"/>
            <Button Grid.Column="1" Content="Open folder" Margin="8,0,0,0" Click="OnOpenFolder"/>
            <TextBlock Grid.Column="2" x:Name="LblHotkeys" Style="{StaticResource Label}"
                       VerticalAlignment="Center" TextAlignment="Right" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
