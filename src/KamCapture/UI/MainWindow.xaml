<Window x:Class="KamCapture.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KAM Capture Tool" Height="484" Width="600"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Navy}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- What you are doing: the first choice, so the largest. -->
        <Style x:Key="ActivityTile" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="74"/>
            <!-- A resting surface, so all three read as equal choices, not one lit label. -->
            <Setter Property="Background" Value="{StaticResource Panel}"/>
        </Style>
        <Style x:Key="ActivityIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- What to point it at: a smaller segmented choice underneath. -->
        <Style x:Key="Segment" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Width" Value="154"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource PanelHi}"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Width" Value="62"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- The update button: a quiet icon until there is something to say,
             then a gold chip that says it. -->
        <Style x:Key="UpdateChip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="8,5" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource PanelHi}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UpdateGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Shown only when there is an update to talk about. The window grows
             by its height rather than squeezing what is below. -->
        <Border x:Name="UpdateBar" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid Margin="24,10,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="UpdateDot" Width="8" Height="8" Fill="{StaticResource Accent}"
                             VerticalAlignment="Center" Margin="0,0,11,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="18">
                        <Run x:Name="RunUpdate"/>
                        <Hyperlink x:Name="LnkWhatsNew" Click="OnWhatsNew" Foreground="{StaticResource Accent}"
                                   TextDecorations="{x:Null}">What's new</Hyperlink>
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="BtnBarSecondary" Content="Not now" Click="OnBarSecondary"/>
                        <Button x:Name="BtnBarPrimary" Style="{StaticResource PrimaryButton}" Content="Update now"
                                Margin="8,0,0,0" Click="OnBarPrimary"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Margin="24,20,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ header ============ -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/kam-capture.png"
                           Width="40" Height="40" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="KAM Capture Tool" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LblSubtitle" Style="{StaticResource Label}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BtnUpdates" Style="{StaticResource UpdateChip}" Click="OnUpdatesClick"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,0,0"
                        AutomationProperties.Name="Updates">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16">
                            <!-- Circling arrow: check for updates. -->
                            <Path x:Name="IconCheck" Style="{StaticResource UpdateGlyph}" RenderTransformOrigin="0.5,0.5"
                                  Data="M13.9,8.7 A5.9,5.9 0 1 1 12.2,3.9 M13.4,1.7 L13.4,4.9 L10.2,4.9">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinCheck"/>
                                </Path.RenderTransform>
                            </Path>
                            <!-- Arrow into a tray: a new version to download. -->
                            <Path x:Name="IconDownload" Style="{StaticResource UpdateGlyph}" Visibility="Collapsed"
                                  Data="M8,2 L8,10.4 M4.6,7 L8,10.4 L11.4,7 M2.5,13.8 L13.5,13.8"/>
                        </Grid>
                        <TextBlock x:Name="LblUpdates" Margin="7,0,1,0" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============ 1. what are you doing ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="ActScreenshot" Grid.Column="0" Style="{StaticResource ActivityTile}"
                              Tag="Screenshot" Click="OnActivityClick"
                              ToolTip="Capture a still image of part of the screen">
                    <StackPanel>
                        <Path Style="{StaticResource ActivityIcon}"
                              Data="M3,7 L3,3 L7,3 M15,3 L19,3 L19,7 M3,15 L3,19 L7,19 M19,15 L19,19 L15,19"/>
                        <TextBlock Text="Screenshot" HorizontalAlignment="Center" Margin="0,7,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="ActVideo" Grid.Column="2" Style="{StaticResource ActivityTile}"
                              Tag="Video" Click="OnActivityClick"
                              ToolTip="Record the screen, with sound if you want it">
                    <StackPanel>
                        <Path Style="{StaticResource ActivityIcon}"
                              Data="M2.5,6 L13.5,6 L13.5,16 L2.5,16 Z M13.5,9.5 L19.5,6.5 L19.5,15.5 L13.5,12.5 Z"/>
                        <TextBlock Text="Video" HorizontalAlignment="Center" Margin="0,7,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="ActAudio" Grid.Column="4" Style="{StaticResource ActivityTile}"
                              Tag="Audio" Click="OnActivityClick"
                              ToolTip="Record sound only: what the computer plays, your microphone, or both">
                    <StackPanel>
                        <Path Style="{StaticResource ActivityIcon}"
                              Data="M11,2.5 A2.8,2.8 0 0 1 13.8,5.3 L13.8,10.2 A2.8,2.8 0 0 1 8.2,10.2 L8.2,5.3 A2.8,2.8 0 0 1 11,2.5 Z M5.5,10.2 A5.5,5.5 0 0 0 16.5,10.2 M11,15.7 L11,19"/>
                        <TextBlock Text="Audio" HorizontalAlignment="Center" Margin="0,7,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- ============ 2. only the options for that ============
                 Fixed height, so the button below never moves as you switch. -->
            <StackPanel Grid.Row="2" x:Name="Options" Margin="0,18,0,0" Height="116" VerticalAlignment="Top">

                <StackPanel x:Name="RowWhat" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource RowLabel}" Text="What"/>
                    <ToggleButton x:Name="WhatRegion" Style="{StaticResource Segment}" Tag="Region" Click="OnWhatClick"
                                  Content="Region" ToolTip="Drag any part of the screen"/>
                    <ToggleButton x:Name="WhatWindow" Style="{StaticResource Segment}" Tag="Window" Click="OnWhatClick"
                                  Content="Window" ToolTip="Hover a window and click it"/>
                    <ToggleButton x:Name="WhatScreen" Style="{StaticResource Segment}" Tag="Monitor" Click="OnWhatClick"
                                  Content="Full screen" Margin="0" ToolTip="The whole display the pointer is on"/>
                </StackPanel>

                <StackPanel x:Name="RowDelay" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Delay"/>
                    <ComboBox x:Name="CmbDelay" Width="154" VerticalAlignment="Center"
                              ToolTip="Wait before capturing, to open a menu first"/>
                </StackPanel>

                <StackPanel x:Name="RowSystem" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Sound"/>
                    <CheckBox x:Name="ChkSystem" Content="System audio" Width="134" VerticalAlignment="Center"
                              Click="OnSoundToggled"
                              ToolTip="Whatever the computer plays: a Teams call, a video, the lecture"/>
                    <ComboBox x:Name="CmbOutput" Width="340" VerticalAlignment="Center"
                              SelectionChanged="OnOutputChanged" DropDownOpened="OnDevicesOpened"
                              ToolTip="Every output records whatever the computer plays, through whichever output it plays. Pick one to record only that."/>
                </StackPanel>

                <StackPanel x:Name="RowMic" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                    <CheckBox x:Name="ChkMic" Content="Microphone" Width="134" VerticalAlignment="Center"
                              Click="OnSoundToggled" ToolTip="Your voice"/>
                    <ComboBox x:Name="CmbMic" Width="340" VerticalAlignment="Center"
                              SelectionChanged="OnMicChanged" DropDownOpened="OnDevicesOpened"/>
                </StackPanel>

                <TextBlock x:Name="LblNote" Style="{StaticResource Label}" Margin="62,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ============ 3. do it ============ -->
            <Button Grid.Row="3" x:Name="BtnPrimary" Style="{StaticResource PrimaryButton}"
                    Padding="0,13" FontSize="15" Margin="0,16,0,0" Click="OnPrimary"/>

            <!-- One line, always: what just happened, or else the shortcut for
                 what is selected. It never wraps, so it can never be cut off;
                 the whole message is in the tooltip. -->
            <TextBlock Grid.Row="4" x:Name="LblStatus" Style="{StaticResource Label}"
                       TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>

            <Grid Grid.Row="6" Margin="0,12,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Settings" Click="OnSettings"/>
                <!-- One button per kind, each to its own folder. -->
                <Button Grid.Column="2" x:Name="BtnOpenShots" Content="Open Screenshots" Click="OnOpenScreenshots"/>
                <Button Grid.Column="3" x:Name="BtnOpenVideo" Content="Open Video" Margin="8,0,0,0" Click="OnOpenVideo"/>
                <Button Grid.Column="4" x:Name="BtnOpenAudio" Content="Open Audio" Margin="8,0,0,0" Click="OnOpenAudio"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
