<Window x:Class="KamCapture.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KAM Capture Tool" Height="560" Width="628"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Navy}" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ModeToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Width" Value="174"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ModeIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Grid Width="44" Height="44" VerticalAlignment="Center">
                <Ellipse Fill="#FF0A0D14"/>
                <Path Stroke="#FF4A7CFF" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Stretch="None" Width="44" Height="44"
                      Data="M10,16.5 L10,10 L16.5,10 M27.5,10 L34,10 L34,16.5 M10,27.5 L10,34 L16.5,34 M34,27.5 L34,34 L27.5,34"/>
                <Path Fill="#FF3A63D8" Stretch="None" Width="44" Height="44"
                      Data="M16.2,27.8 L27.8,16.2 L30.6,19 L19,30.6 Z"/>
                <Path Fill="#FF9CBEFF" Stretch="None" Width="44" Height="44"
                      Data="M16.2,27.8 L19,30.6 L13.4,32.6 Z"/>
            </Grid>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="KAM Capture Tool" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="LblSubtitle" Style="{StaticResource Label}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- modes -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <ToggleButton x:Name="ModeRegion" Style="{StaticResource ModeToggle}" Tag="Region" Click="OnModeClick"
                          ToolTip="Drag any part of the screen. The selection stays adjustable before you commit.">
                <StackPanel>
                    <Path Style="{StaticResource ModeIcon}" Data="M3,7 L3,3 L7,3 M15,3 L19,3 L19,7 M3,15 L3,19 L7,19 M19,15 L19,19 L15,19"/>
                    <TextBlock Text="Capture" HorizontalAlignment="Center" Margin="0,6,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ModeWindow" Style="{StaticResource ModeToggle}" Tag="Window" Click="OnModeClick"
                          ToolTip="Hover any window and click it. The whole window is captured, shadow and all.">
                <StackPanel>
                    <Path Style="{StaticResource ModeIcon}" Data="M3,5 L19,5 L19,17 L3,17 Z M3,8.5 L19,8.5"/>
                    <TextBlock Text="Window" HorizontalAlignment="Center" Margin="0,6,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ModeMonitor" Style="{StaticResource ModeToggle}" Tag="Monitor" Click="OnModeClick"
                          ToolTip="The entire display the pointer is on, in one click.">
                <StackPanel>
                    <Path Style="{StaticResource ModeIcon}" Data="M2.5,4 L19.5,4 L19.5,14.5 L2.5,14.5 Z M8,18 L14,18 M11,14.5 L11,18"/>
                    <TextBlock Text="Monitor" HorizontalAlignment="Center" Margin="0,6,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- actions -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnCapture" Style="{StaticResource PrimaryButton}" Content="New capture"
                        Padding="26,12" FontSize="15" Click="OnCapture"/>
                <TextBlock Style="{StaticResource Label}" Text="Delay" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="CmbDelay" Width="118" VerticalAlignment="Center"/>
                <Button x:Name="BtnRecord" Content="Record screen" Padding="18,12" Margin="16,0,0,0"
                        FontSize="14" Click="OnRecord"/>
            </StackPanel>
        </Grid>

        <!-- options -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="After a capture"/>
                <WrapPanel Margin="0,10,0,0">
                    <CheckBox x:Name="ChkClipboard" Content="Copy to clipboard" Margin="0,0,22,8" Click="OnOptionChanged"/>
                    <CheckBox x:Name="ChkEditor" Content="Open the annotator" Margin="0,0,22,8" Click="OnOptionChanged"/>
                    <CheckBox x:Name="ChkAutoSave" Content="Save a PNG" Margin="0,0,22,8" Click="OnOptionChanged"/>
                    <CheckBox x:Name="ChkCursor" Content="Include the cursor" Margin="0,0,22,8" Click="OnOptionChanged"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- status -->
        <Border Grid.Row="4" VerticalAlignment="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="LblStatus" Style="{StaticResource Label}" TextWrapping="Wrap"/>
        </Border>

        <!-- footer -->
        <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,14,0,16">
            <Button Content="Settings" Click="OnSettings"/>
            <Button Content="Open captures folder" Margin="8,0,0,0" Click="OnOpenFolder"/>
            <TextBlock DockPanel.Dock="Right" x:Name="LblHotkeys" Style="{StaticResource Label}"
                       VerticalAlignment="Center" TextAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
