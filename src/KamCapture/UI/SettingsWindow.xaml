<Window x:Class="KamCapture.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KAM Capture Tool — Settings" Height="700" Width="660"
        MinHeight="500" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Navy}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- One row shape everywhere: fixed-width label, then the control. -->
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,4,0,14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,20,20,4">
            <StackPanel>

                <!-- ===== capture ===== -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Capture"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Every capture is taken from the desktop at full device resolution and then cropped, so a small selection keeps every real pixel."/>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Start with"/>
                            <ComboBox x:Name="CmbDefaultMode" Width="150" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Delay" Width="60" Margin="20,0,0,0"/>
                            <ComboBox x:Name="CmbDelay" Width="120" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Afterwards"/>
                            <StackPanel>
                                <CheckBox x:Name="ChkClipboard" Content="Copy to the clipboard" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkOpenEditor" Content="Open the annotator" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkAutoSave" Content="Save a PNG straight away" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkAskName" Content="Ask what to call it when saving" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkCursor" Content="Include the mouse cursor"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Save to"/>
                            <TextBox x:Name="TxtSaveFolder" Width="330" VerticalAlignment="Center"/>
                            <Button Content="Browse" Margin="8,0,0,0" Click="OnBrowseSaveFolder"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== selection overlay ===== -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Selection border"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="How the overlay looks while you drag. The preview is the real thing."/>

                        <ContentControl x:Name="HostPreview" Margin="0,0,0,16"/>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Colour"/>
                            <ContentControl x:Name="HostBorderColor" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Style" Width="52" Margin="20,0,0,0"/>
                            <ComboBox x:Name="CmbBorderStyle" Width="120" VerticalAlignment="Center"
                                      SelectionChanged="OnBorderStyleChanged"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Thickness"/>
                            <Slider x:Name="SldBorderThickness" Width="200" Minimum="1" Maximum="8"
                                    VerticalAlignment="Center" ValueChanged="OnPreviewValueChanged"/>
                            <TextBlock x:Name="LblBorderThickness" Style="{StaticResource Label}" Width="46"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Dim the rest"/>
                            <Slider x:Name="SldDim" Width="200" Minimum="0" Maximum="0.9"
                                    VerticalAlignment="Center" ValueChanged="OnPreviewValueChanged"/>
                            <TextBlock x:Name="LblDim" Style="{StaticResource Label}" Width="46"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Show"/>
                            <CheckBox x:Name="ChkCrosshair" Content="Crosshair" Margin="0,0,20,0" Click="OnPreviewToggle"/>
                            <CheckBox x:Name="ChkMagnifier" Content="Magnifier" Margin="0,0,20,0" Click="OnPreviewToggle"/>
                            <CheckBox x:Name="ChkDimensions" Content="Size" Click="OnPreviewToggle"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== annotating ===== -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Annotating"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Text is always Arial; only the size changes. Drawings stay vectors, so exporting at 2x or 3x sharpens them rather than enlarging a blur."/>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Ink"/>
                            <ContentControl x:Name="HostInkColor" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Thickness" Width="74" Margin="20,0,0,0"/>
                            <Slider x:Name="SldInkThickness" Width="150" Minimum="1" Maximum="20" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Text size"/>
                            <Slider x:Name="SldFontSize" Width="200" Minimum="8" Maximum="96" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblFontSize" Style="{StaticResource Label}" Width="46"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Room to write"/>
                            <ComboBox x:Name="CmbSandbox" Width="150" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Export" Width="60" Margin="20,0,0,0"/>
                            <ComboBox x:Name="CmbExportScale" Width="90" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== recording ===== -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Recording"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Audio sources can be changed while recording. The control bar never appears in the recording."/>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Frame rate"/>
                            <ComboBox x:Name="CmbFps" Width="110" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Quality" Width="60" Margin="20,0,0,0"/>
                            <Slider x:Name="SldQuality" Width="130" Minimum="14" Maximum="30" IsDirectionReversed="True"
                                    VerticalAlignment="Center" ValueChanged="OnQualityChanged"/>
                            <TextBlock x:Name="LblQuality" Style="{StaticResource Label}" Width="94"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Save to"/>
                            <TextBox x:Name="TxtRecordFolder" Width="330" VerticalAlignment="Center"/>
                            <Button Content="Browse" Margin="8,0,0,0" Click="OnBrowseRecordFolder"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource RowLabel}" Text="ffmpeg"/>
                            <TextBox x:Name="TxtFfmpeg" Width="330" VerticalAlignment="Center"/>
                            <Button Content="Find" Margin="8,0,0,0" Click="OnFindFfmpeg"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                            <CheckBox x:Name="ChkRecordCursor" Content="Record the cursor" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="LblFfmpegState" Style="{StaticResource Label}" Margin="110,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ===== shortcuts ===== -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Shortcuts"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="These work anywhere in Windows. Click a box and press the combination."/>

                        <CheckBox x:Name="ChkHotkeys" Content="Enable global shortcuts" Margin="0,0,0,14"/>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Capture"/>
                            <ContentControl x:Name="HostHkRegion" Width="160"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Window" Width="74" Margin="20,0,0,0"/>
                            <ContentControl x:Name="HostHkWindow" Width="160"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Monitor"/>
                            <ContentControl x:Name="HostHkFull" Width="160"/>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Record" Width="74" Margin="20,0,0,0"/>
                            <ContentControl x:Name="HostHkRecord" Width="160"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Startup"/>
                            <CheckBox x:Name="ChkStartup" Content="Start with Windows" Margin="0,0,20,0"/>
                            <CheckBox x:Name="ChkTray" Content="Start hidden in the tray"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Row}" Margin="0">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Updates"/>
                            <CheckBox x:Name="ChkUpdates" Content="Check GitHub for new versions" Margin="0,0,20,0"
                                      ToolTip="One request to GitHub when KAM Capture Tool starts, and not again until the next start. Nothing about you or your captures is sent."/>
                            <TextBlock x:Name="LblVersion" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Restore defaults" Click="OnRestoreDefaults"/>
                <Button Grid.Column="2" Content="Cancel" Margin="0,0,8,0" MinWidth="86" Click="OnCancel"/>
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Save"
                        MinWidth="96" Click="OnSaveSettings"/>
            </Grid>
        </Border>
    </Grid>
</Window>
