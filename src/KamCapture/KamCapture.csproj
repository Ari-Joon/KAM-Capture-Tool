<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>

    <AssemblyName>KamCapture</AssemblyName>
    <RootNamespace>KamCapture</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\kam-capture.ico</ApplicationIcon>

    <Product>KAM Capture Tool</Product>
    <AssemblyTitle>KAM Capture Tool</AssemblyTitle>
    <Company>KAM</Company>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Copyright>Copyright (c) 2026 KAM</Copyright>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- The DPI awareness in app.manifest is deliberate and is the reason
         captures come back at real device resolution. WinForms is only here
         for the tray icon and has no say in it. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\kam-capture.ico" />
    <Resource Include="Assets\kam-capture.png" />
  </ItemGroup>

</Project>
